DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
TEST_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Seed is refused unless ALLOW_SEED=true.
# Built-in test passwords (the values below) are allowed only when DATABASE_URL equals TEST_DATABASE_URL.
# Seeding any other database (including cauvira-dev) requires different explicit SEED_* emails and passwords.
ALLOW_SEED=true
SEED_ADMIN_EMAIL=admin@cauvira.test
SEED_ADMIN_PASSWORD=CauviraAdmin!test1
SEED_CATALOG_MANAGER_EMAIL=catalogo@cauvira.test
SEED_CATALOG_MANAGER_PASSWORD=CauviraCatalog!test1
SEED_SALES_EMAIL=ventas@cauvira.test
SEED_SALES_PASSWORD=CauviraSales!test1

# Optional. Required only to upload product photos to the product-images bucket.
# Leave blank in CI. Do not commit real service-role keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
